; winspool_extra.def - import definitions for winspool.drv exports that are
; present in the MSVC Windows SDK import library (winspool.lib) but missing
; from LLVM-MinGW's libwinspool.a (EnumPrinterPropertySheets is exported by
; winspool.drv but not covered by the MinGW import library).
;
; Generate an import library with:
;   llvm-dlltool -m arm -D winspool.drv -d winspool_extra.def -l winspool_extra.a
LIBRARY winspool.drv
EXPORTS
EnumPrinterPropertySheets
