WS2_32_STUB_OBJS = yact/stub_dlls/ws2_32_stub/dllmain.o yact/stub_dlls/ws2_32_stub/stdafx.o yact/stub_dlls/ws2_32_stub/ws2_32.o
WSNMP32_STUB_OBJS = yact/stub_dlls/wsnmp32_stub/dllmain.o yact/stub_dlls/wsnmp32_stub/stdafx.o yact/stub_dlls/wsnmp32_stub/wsnmp32.o
WSOCK32_STUB_OBJS = yact/stub_dlls/wsock32_stub/dllmain.o yact/stub_dlls/wsock32_stub/stdafx.o yact/stub_dlls/wsock32_stub/wsock32.o
WTSAPI32_STUB_OBJS = yact/stub_dlls/wtsapi32_stub/dllmain.o yact/stub_dlls/wtsapi32_stub/stdafx.o yact/stub_dlls/wtsapi32_stub/wtsapi32.o

STUB_NAMES = aclui advapi32 cfgmgr32 comctl32 comdlg32 crypt32 d3d9 dbghelp ddraw dhcpcsvc dinput8 dinput dnsapi dsound faultrep gdi32 gdiplus hid icmui imagehlp imm32 iphlpapi kernel32 ksuser lz32 mapi32 mgmtapi mpr mprapi msacm32 mscms msdmo msimg32 mswsock nddeapi netapi32 newdev ntdll odbc32 odbccp32 ole32 oleacc oleaut32 oledlg powrprof psapi rasapi32 rasdlg riched20 riched32 rpcns4 rpcrt4 rtutils secur32 setupapi shell32 shfolder shlwapi snmpapi tapi32 url user32 userenv usp10 uxtheme version win32spl wininet winmm winspool ws2_32 wsnmp32 wsock32 wtsapi32

# per-stub flags (same vcxproj settings the MSVC build uses)
$(STUB_DLLS_DIR)/kernel32_stub/%.o: STUB_EXTRA_FLAGS += -fno-omit-frame-pointer
$(STUB_DLLS_DIR)/ddraw_stub/%.o: STUB_EXTRA_FLAGS += -fno-rtti
$(STUB_DLLS_DIR)/dinput8_stub/%.o: STUB_EXTRA_FLAGS += -DDIRECTINPUT_VERSION=0x800

# ntdll.def / cfgmgr32.def add the forwarder exports (e.g. _CIcos=msvcrt._CIcos)
STUB_DEFS_ntdll = $(STUB_DLLS_DIR)/ntdll_stub/ntdll.def
STUB_DEFS_cfgmgr32 = $(STUB_DLLS_DIR)/cfgmgr32_stub/cfgmgr32.def

define STUB_template
$(STUB_DLLS_DIR)/$(1)_stub/%.o: $(STUB_DLLS_DIR)/$(1)_stub/%.cpp
	$$(CXX) $$(STUB_CXXFLAGS) $$(STUB_EXTRA_FLAGS) -D$(2)_STUB_EXPORTS -I$$(STUB_DLLS_DIR)/$(1)_stub $$(INCLUDES) -c $$< -o $$@

$(RELEASE_DIR)/$(1).86.dll: $$($(2)_STUB_OBJS) $(RELEASE_DIR)/supp.86.dll $$(STUB_CRT_OBJ)
	$$(CXX) $$(STUB_LDFLAGS) -o $$@ $$($(2)_STUB_OBJS) $$(STUB_CRT_OBJ) $(RELEASE_DIR)/supp.86.dll $$(STUB_DEFS_$(1)) $$(STUB_LIBS)
endef

$(foreach s,$(STUB_NAMES),$(eval $(call STUB_template,$(s),$(shell echo $(s) | tr a-z A-Z))))

# dinput8_stub compiles dinput_stub/dinput_common.cpp (see dinput8_stub.vcxproj)
$(STUB_DLLS_DIR)/dinput8_stub/dinput_common.o: $(STUB_DLLS_DIR)/dinput_stub/dinput_common.cpp
	$(CXX) $(STUB_CXXFLAGS) -DDIRECTINPUT_VERSION=0x800 -DDINPUT8_STUB_EXPORTS -I$(STUB_DLLS_DIR)/dinput8_stub $(INCLUDES) -c $< -o $@

stubs: $(addprefix $(RELEASE_DIR)/,$(addsuffix .86.dll,$(STUB_NAMES)))

clean:
	rm -f $(SUPP_DIR)/*.o $(YACT_EMU_DIR)/*.o $(X86_EMU_DIR)/*.o $(CBACKS_DIR)/*.o
	rm -f $(RELEASE_DIR)/*.dll
	rm -f $(STUB_DLLS_DIR)/*.o $(STUB_DLLS_DIR)/*/*.o

.PHONY: all clean stubs
