# Win86emun Cross-Compilation Makefile for MinGW-w64
# Target: Windows x86 (i686)

CROSS_PREFIX = i686-w64-mingw32
CXX = $(CROSS_PREFIX)-g++
CC = $(CROSS_PREFIX)-gcc
WINDRES = $(CROSS_PREFIX)-windres

CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -fno-strict-aliasing
CFLAGS = -Wall -Wextra -O2
LDFLAGS = -shared -static-libgcc -static-libstdc++

INCLUDES = -I./yact/inc -I./yact
DEFINES = -DWIN32 -D_WINDOWS -D_USRDLL -DNDEBUG

YACT_EMU_DIR = yact/yact_emu
X86_EMU_DIR = yact/x86_emu
SUPP_DIR = yact/supp
CBACKS_DIR = yact/cbacks
RELEASE_DIR = release

$(shell mkdir -p $(RELEASE_DIR))

SUPP_OBJS = $(SUPP_DIR)/dllmain.o $(SUPP_DIR)/logging.o $(SUPP_DIR)/supp.o
YACT_EMU_OBJS = $(YACT_EMU_DIR)/cmdstream.o $(YACT_EMU_DIR)/dllmain.o $(YACT_EMU_DIR)/operands.o $(YACT_EMU_DIR)/onebytecmds.o $(YACT_EMU_DIR)/stdafx.o $(YACT_EMU_DIR)/twobytecmds.o $(YACT_EMU_DIR)/yact_emu.o
X86_EMU_OBJS = $(X86_EMU_DIR)/dllmain.o $(X86_EMU_DIR)/stdafx.o $(X86_EMU_DIR)/x86_emu.o
CBACKS_OBJS = $(CBACKS_DIR)/callbacks.o $(CBACKS_DIR)/dllmain.o

all: $(RELEASE_DIR)/supp.nt.dll $(RELEASE_DIR)/yact_emu.dll $(RELEASE_DIR)/x86_emu.dll $(RELEASE_DIR)/cbacks.nt.dll

$(RELEASE_DIR)/supp.nt.dll: $(SUPP_OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32 -luser32 -ladvapi32

$(RELEASE_DIR)/yact_emu.dll: $(YACT_EMU_OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32

$(RELEASE_DIR)/x86_emu.dll: $(X86_EMU_OBJS) $(RELEASE_DIR)/supp.nt.dll
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32 -luser32

# cbacks.nt.dll depends on supp.nt.dll; x86_emu.dll provides EmuExecute
$(RELEASE_DIR)/cbacks.nt.dll: $(CBACKS_OBJS) $(RELEASE_DIR)/supp.nt.dll $(RELEASE_DIR)/x86_emu.dll
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32 -luser32 -ladvapi32

$(SUPP_DIR)/%.o: $(SUPP_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DSUPP_EXPORTS $(INCLUDES) -c $< -o $@

$(YACT_EMU_DIR)/%.o: $(YACT_EMU_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DYACT_EMU_EXPORTS $(INCLUDES) -c $< -o $@

$(X86_EMU_DIR)/%.o: $(X86_EMU_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DX86_EMU_EXPORTS $(INCLUDES) -c $< -o $@

$(CBACKS_DIR)/%.o: $(CBACKS_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DCBACKS_EXPORTS $(INCLUDES) -c $< -o $@

# ===========================================================================
# x86 stub DLLs (yact.sln stub_dlls, 74 projects) - target: stubs
#
# The MSVC build of these DLLs uses the static CRT (MultiThreaded) and links
# no CRT DLL, because the emulated x86 environment contains only the *.86
# DLLs: an unresolved api-ms-win-crt-*.dll / msvcrt.dll import makes PeLdr
# fail the whole module load.  LLVM-MinGW is UCRT-only, so this build links
# the stubs with -nostartfiles plus stub_crt.cpp (see that file), which
# supplies DllMainCRTStartup / memcpy / memset / sprintf / operator new-delete
# without pulling in the UCRT.  Verified: all 74 DLLs link with imports from
# KERNEL32/ADVAPI32/ole32/ddraw/supp.86 only (no api-ms-*).
# ===========================================================================
STUB_DLLS_DIR = yact/stub_dlls
STUB_CRT_OBJ = $(STUB_DLLS_DIR)/stub_crt.o
STUB_CXXFLAGS = -std=c++17 -O2 -fasm-blocks -D__in= -D__out= -DWIN32 -D_WINDOWS -D_USRDLL -DNDEBUG -DUNICODE -D_UNICODE
STUB_LDFLAGS = -shared -nostartfiles -static-libgcc -static-libstdc++
STUB_LIBS = -lkernel32 -luser32 -lgdi32 -lwinspool -lcomdlg32 -ladvapi32 -lshell32 -lole32 -loleaut32 -luuid -lodbc32 -lodbccp32 -lddraw -ldxguid -lversion -lws2_32 -lcomctl32

$(STUB_CRT_OBJ): $(STUB_DLLS_DIR)/stub_crt.cpp
	$(CXX) -std=c++17 -O2 -fno-builtin -fno-exceptions -fno-rtti -c $< -o $@

# supp.86.dll: the x86 build of supp, loaded by the stub DLLs in the emulated
# environment (the stubs import supp.86.dll).
$(RELEASE_DIR)/supp.86.dll: $(SUPP_OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32 -luser32 -ladvapi32

ACLUI_STUB_OBJS = yact/stub_dlls/aclui_stub/dllmain.o yact/stub_dlls/aclui_stub/stdafx.o yact/stub_dlls/aclui_stub/aclui.o
ADVAPI32_STUB_OBJS = yact/stub_dlls/advapi32_stub/advapi32.o yact/stub_dlls/advapi32_stub/dllmain.o yact/stub_dlls/advapi32_stub/stdafx.o
