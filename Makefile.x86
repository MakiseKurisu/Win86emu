DBGHELP_STUB_OBJS = yact/stub_dlls/dbghelp_stub/dbghelp.o yact/stub_dlls/dbghelp_stub/dllmain.o yact/stub_dlls/dbghelp_stub/stdafx.o
DDRAW_STUB_OBJS = yact/stub_dlls/ddraw_stub/ddraw.o yact/stub_dlls/ddraw_stub/ddraw_impl86.o yact/stub_dlls/ddraw_stub/dllmain.o yact/stub_dlls/ddraw_stub/stdafx.o
DHCPCSVC_STUB_OBJS = yact/stub_dlls/dhcpcsvc_stub/dllmain.o yact/stub_dlls/dhcpcsvc_stub/stdafx.o yact/stub_dlls/dhcpcsvc_stub/dhcpcsvc.o
DINPUT8_STUB_OBJS = yact/stub_dlls/dinput8_stub/dinput_common.o yact/stub_dlls/dinput8_stub/dinput8_86.o yact/stub_dlls/dinput8_stub/dllmain.o yact/stub_dlls/dinput8_stub/stdafx.o
