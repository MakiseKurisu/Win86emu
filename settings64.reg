REGEDIT4

; Win86emun settings for 64-bit Windows. The emulator front end is a 32-bit
; process, so HKLM\SOFTWARE\x86node\Settings is read from the 32-bit registry
; view (Wow6432Node); HKCU is shared and is checked first.
; On Windows RT (32-bit) use settings.reg instead.
; The emulator reads these values once per process - restart the application
; after changing them. See LOGGING.md for the debug log details.
;
; LogLevel      0=off 1=ERROR 2=WARN (default) 3=INFO 4=DEBUG 5=TRACE
; LogFile       full path of the log file (default: %TEMP%\win86emu.log).
;               REG_SZ or REG_EXPAND_SZ; environment variables are expanded.
; LogMaxSizeKB  rotate the log when it reaches this size in KB, 0 disables it

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\x86node\Settings]
"LogLevel"=dword:00000002
"LogFile"=hex(2):25,54,45,4d,50,25,5c,77,69,6e,38,36,65,6d,75,2e,6c,6f,67,00
"LogMaxSizeKB"=dword:00002000

; Per-program compatibility settings (CompatGetInt) are read from
; ...\Compatibility\<exe name> first, then from ...\Compatibility itself.

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\x86node\Compatibility]

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\x86node\Compatibility\Heroes3.exe]
"NoRaiseException"=dword:00000001
