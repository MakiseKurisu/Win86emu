# Win86emun Cross-Compilation Makefile for LLVM-MinGW
# Target: Windows ARM32 (armv7)
#
# Targets:
#   all     - the four core native DLLs (supp.nt, yact_emu, x86_emu, cbacks.nt)
#   native  - the four core native DLLs plus peldr.nt, cpihook.nt, dosbox_emu,
#             bochs_emu and the 72 yact system DLLs (targets: all + yact)
#   yact    - the 72 native system_dlls replacement DLLs (*.nt.dll)
#   dosbox-slots - the dosbox_emu1..15.dll engine copies (release config)
#   clean   - remove build artifacts
#
# The x86 *.86.dll stub DLLs are NOT built here; see Makefile.x86 (target: stubs).

CROSS_PREFIX = armv7-w64-mingw32
CXX = $(CROSS_PREFIX)-g++
CC = $(CROSS_PREFIX)-gcc
WINDRES = $(CROSS_PREFIX)-windres

# Compiler flags for ARM32
# -march=armv7-a: ARMv7-A architecture (Windows RT devices)
# -mthumb: Thumb-2 instruction set (better code density)
# -mno-unaligned-access: Prevent unaligned memory access faults on ARM
CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -fno-strict-aliasing -march=armv7-a -mthumb -mno-unaligned-access
CFLAGS = -Wall -Wextra -O2 -march=armv7-a -mthumb -mno-unaligned-access
LDFLAGS = -shared -static-libgcc -static-libstdc++

# Include paths
INCLUDES = -I./yact/inc -I./yact

# Preprocessor definitions
DEFINES = -DWIN32 -D_WINDOWS -D_USRDLL -DNDEBUG

# Directories
YACT_EMU_DIR = yact/yact_emu
X86_EMU_DIR = yact/x86_emu
SUPP_DIR = yact/supp
CBACKS_DIR = yact/cbacks
RELEASE_DIR = release
OBJ_DIR = obj

# Create output directories
$(shell mkdir -p $(RELEASE_DIR) $(OBJ_DIR)/supp $(OBJ_DIR)/yact_emu $(OBJ_DIR)/x86_emu)

# Source files for supp.nt.dll
SUPP_SRCS = $(SUPP_DIR)/dllmain.cpp \
            $(SUPP_DIR)/logging.cpp \
            $(SUPP_DIR)/supp.cpp

SUPP_OBJS = $(SUPP_DIR)/dllmain.o \
            $(SUPP_DIR)/logging.o \
            $(SUPP_DIR)/supp.o

# Source files for yact_emu.dll
YACT_EMU_SRCS = $(YACT_EMU_DIR)/cmdstream.cpp \
                $(YACT_EMU_DIR)/dllmain.cpp \
                $(YACT_EMU_DIR)/operands.cpp \
                $(YACT_EMU_DIR)/onebytecmds.cpp \
                $(YACT_EMU_DIR)/stdafx.cpp \
                $(YACT_EMU_DIR)/twobytecmds.cpp \
                $(YACT_EMU_DIR)/yact_emu.cpp

YACT_EMU_OBJS = $(YACT_EMU_DIR)/cmdstream.o \
                $(YACT_EMU_DIR)/dllmain.o \
                $(YACT_EMU_DIR)/operands.o \
                $(YACT_EMU_DIR)/onebytecmds.o \
                $(YACT_EMU_DIR)/stdafx.o \
                $(YACT_EMU_DIR)/twobytecmds.o \
                $(YACT_EMU_DIR)/yact_emu.o

# Source files for x86_emu.dll
X86_EMU_SRCS = $(X86_EMU_DIR)/dllmain.cpp \
               $(X86_EMU_DIR)/stdafx.cpp \
               $(X86_EMU_DIR)/x86_emu.cpp

X86_EMU_OBJS = $(X86_EMU_DIR)/dllmain.o \
               $(X86_EMU_DIR)/stdafx.o \
               $(X86_EMU_DIR)/x86_emu.o

# Source files for cbacks.nt.dll
CBACKS_SRCS = $(CBACKS_DIR)/callbacks.cpp \
              $(CBACKS_DIR)/dllmain.cpp

CBACKS_OBJS = $(CBACKS_DIR)/callbacks.o \
              $(CBACKS_DIR)/dllmain.o

# Default target
all: $(RELEASE_DIR)/supp.nt.dll $(RELEASE_DIR)/yact_emu.dll $(RELEASE_DIR)/x86_emu.dll $(RELEASE_DIR)/cbacks.nt.dll

# Link supp.nt.dll
$(RELEASE_DIR)/supp.nt.dll: $(SUPP_OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32 -luser32 -ladvapi32

# Link yact_emu.dll
$(RELEASE_DIR)/yact_emu.dll: $(YACT_EMU_OBJS)
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32

# Link x86_emu.dll (depends on supp.nt.dll)
$(RELEASE_DIR)/x86_emu.dll: $(X86_EMU_OBJS) $(RELEASE_DIR)/supp.nt.dll
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32 -luser32

# Link cbacks.nt.dll (depends on supp.nt.dll; x86_emu.dll provides EmuExecute)
$(RELEASE_DIR)/cbacks.nt.dll: $(CBACKS_OBJS) $(RELEASE_DIR)/supp.nt.dll $(RELEASE_DIR)/x86_emu.dll
	$(CXX) $(LDFLAGS) -o $@ $^ -lkernel32 -luser32 -ladvapi32

# Compile supp sources
$(SUPP_DIR)/%.o: $(SUPP_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DSUPP_EXPORTS $(INCLUDES) -c $< -o $@

# Compile yact_emu sources
$(YACT_EMU_DIR)/%.o: $(YACT_EMU_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DYACT_EMU_EXPORTS $(INCLUDES) -c $< -o $@

# Compile x86_emu sources
$(X86_EMU_DIR)/%.o: $(X86_EMU_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DX86_EMU_EXPORTS $(INCLUDES) -c $< -o $@

# Compile cbacks sources
$(CBACKS_DIR)/%.o: $(CBACKS_DIR)/%.cpp
	$(CXX) $(CXXFLAGS) $(DEFINES) -DCBACKS_EXPORTS $(INCLUDES) -c $< -o $@

# ===========================================================================
# Phase 8: native ARM32 DLLs beyond the core four - targets: native, yact
#
# The sources are the MSVC project sources, compiled with clang
# -fms-extensions (MSVC syntax: __try/__except, __declspec(thread), __int64,
# __fastcall, ...) and -DUNICODE/-D_UNICODE (all projects have
# CharacterSet=Unicode, so MSBuild defines them for the MSVC build).
#
# Notes:
#  - llvm-mingw is UCRT-only: every DLL below imports api-ms-win-crt-* (on
#    Windows RT 8.x this requires KB2999226, same as the core four).
#  - -DUNICODE/-D_UNICODE is added per project (all yact system_dlls, peldr
#    and cpihook have CharacterSet=Unicode, so MSBuild defines them for the
#    MSVC build; dosbox_emu and bochs_emu are MultiByte and do not get them).
#  - wininet_yact/winspool_yact reference undocumented exports that are in the
#    MSVC Windows SDK import libraries but missing from llvm-mingw's; extra
#    import libraries are generated from the checked-in .def files (dlltool).
#  - ntdll_yact uses the project's own MSVC ARM import library (ntdll_arm.lib)
#    because llvm-mingw's libntdll.a lacks RtlConvertUiListToApiList.
# ===========================================================================
NATIVE_CXXFLAGS = -std=c++17 -O2 -fms-extensions -Wno-dynamic-exception-spec -Wno-register -Wno-reserved-user-defined-literal -march=armv7-a -mthumb -mno-unaligned-access -D_M_ARM -DWIN32 -D_WINDOWS -D_USRDLL -DNDEBUG
NATIVE_LDFLAGS = -shared -static-libgcc -static-libstdc++
# Union of the AdditionalDependencies of the 72 yact projects (each link gets
# the whole union; unused import libraries are harmless). ntdll is deliberately
# absent: MinGW's libntdll.a lacks RtlConvertUiListToApiList, so the ntdll_yact
# link uses the project's own MSVC ARM import library instead (extra lib below).
NATIVE_LIBS = -laclui -ladvapi32 -lcfgmgr32 -lcomctl32 -lcomdlg32 -lcrypt32 -ld3d9 -ldbghelp -ldhcpcsvc -ldnsapi -ldsound -ldxguid -lfaultrep -lgdi32 -lgdiplus -lhid -licmui -limagehlp -limm32 -liphlpapi -lkernel32 -lksuser -llz32 -lmapi32 -lmgmtapi -lmpr -lmprapi -lmsacm32 -lmscms -lmsdmo -lmsimg32 -lmswsock -lnddeapi -lnetapi32 -lnewdev -lodbc32 -lodbccp32 -lole32 -loleacc -loleaut32 -loledlg -lpowrprof -lpsapi -lrasapi32 -lrasdlg -lrpcns4 -lrpcrt4 -lrtutils -lsecur32 -lsetupapi -lshell32 -lshfolder -lshlwapi -lsnmpapi -ltapi32 -luser32 -luserenv -lusp10 -luuid -luxtheme -lversion -lwininet -lwinmm -lwinspool -lws2_32 -lwsnmp32 -lwsock32 -lwtsapi32
NATIVE_REFS = $(RELEASE_DIR)/supp.nt.dll $(RELEASE_DIR)/cbacks.nt.dll $(RELEASE_DIR)/x86_emu.dll $(RELEASE_DIR)/peldr.nt.dll
YACT_DLLS_DIR = yact/system_dlls

# Extra import libraries missing from llvm-mingw (generated from the .def files)
$(OBJ_DIR)/libwininet_extra.a: $(YACT_DLLS_DIR)/wininet_yact/wininet_extra.def
	$(CROSS_PREFIX)-dlltool -m arm -D wininet.dll -d $< -l $@

$(OBJ_DIR)/libwinspool_extra.a: $(YACT_DLLS_DIR)/winspool_yact/winspool_extra.def
	$(CROSS_PREFIX)-dlltool -m arm -D winspool.drv -d $< -l $@

# ---- peldr.nt.dll ---------------------------------------------------------
# PE loader; exports are declared with PE_EXPORT (defined on the command line
# like the MSVC build); the min/max macros come from the project settings.
PELDR_DIR = yact/peldr
PELDR_OBJS = $(PELDR_DIR)/dllmain.o \
             $(PELDR_DIR)/peldr.o \
             $(PELDR_DIR)/program.o \
             $(PELDR_DIR)/stdafx.o
PELDR_CXXFLAGS = $(NATIVE_CXXFLAGS) -DUNICODE -D_UNICODE -D__in= -D__out= -D'min(a,b)=((a)<(b)?(a):(b))' -D'max(a,b)=((a)>(b)?(a):(b))' -DPE_EXPORT='__declspec(dllexport)'

$(PELDR_DIR)/%.o: $(PELDR_DIR)/%.cpp
	$(CXX) $(PELDR_CXXFLAGS) -I$(PELDR_DIR) $(INCLUDES) -c $< -o $@

$(RELEASE_DIR)/peldr.nt.dll: $(PELDR_OBJS) $(RELEASE_DIR)/supp.nt.dll $(RELEASE_DIR)/cbacks.nt.dll $(RELEASE_DIR)/x86_emu.dll
	$(CXX) $(NATIVE_LDFLAGS) -o $@ $(PELDR_OBJS) $(RELEASE_DIR)/supp.nt.dll $(RELEASE_DIR)/cbacks.nt.dll $(RELEASE_DIR)/x86_emu.dll -lkernel32 -limagehlp -lntdll -ldbghelp

# ---- cpihook.nt.dll -------------------------------------------------------
CPIHOOK_DIR = yact/cpihook
CPIHOOK_OBJS = $(CPIHOOK_DIR)/cpihook.o \
               $(CPIHOOK_DIR)/dllmain.o \
               $(CPIHOOK_DIR)/stdafx.o

$(CPIHOOK_DIR)/%.o: $(CPIHOOK_DIR)/%.cpp
	$(CXX) $(NATIVE_CXXFLAGS) -DUNICODE -D_UNICODE -DCPIHOOK_EXPORTS -I$(CPIHOOK_DIR) $(INCLUDES) -c $< -o $@

$(RELEASE_DIR)/cpihook.nt.dll: $(CPIHOOK_OBJS)
	$(CXX) $(NATIVE_LDFLAGS) -o $@ $(CPIHOOK_OBJS) -lkernel32 -luser32 -ladvapi32 -lshell32 -lole32

# ---- dosbox_emu.dll -------------------------------------------------------
DOSBOX_DIR = yact/dosbox_emu
DOSBOX_OBJS = $(DOSBOX_DIR)/callback.o \
              $(DOSBOX_DIR)/core_dyn_x86.o \
              $(DOSBOX_DIR)/core_dynrec.o \
              $(DOSBOX_DIR)/core_full.o \
              $(DOSBOX_DIR)/core_normal.o \
              $(DOSBOX_DIR)/core_prefetch.o \
              $(DOSBOX_DIR)/core_simple.o \
              $(DOSBOX_DIR)/cpu.o \
              $(DOSBOX_DIR)/cross.o \
              $(DOSBOX_DIR)/dllmain.o \
              $(DOSBOX_DIR)/dosbox_emu.o \
              $(DOSBOX_DIR)/flags.o \
              $(DOSBOX_DIR)/fpu.o \
              $(DOSBOX_DIR)/memory.o \
              $(DOSBOX_DIR)/messages.o \
              $(DOSBOX_DIR)/mmx.o \
              $(DOSBOX_DIR)/modrm.o \
              $(DOSBOX_DIR)/paging.o \
              $(DOSBOX_DIR)/setup.o \
              $(DOSBOX_DIR)/stdafx.o \
              $(DOSBOX_DIR)/support.o

$(DOSBOX_DIR)/%.o: $(DOSBOX_DIR)/%.cpp
	$(CXX) $(NATIVE_CXXFLAGS) -DDOSBOX_EMU_EXPORTS -I$(DOSBOX_DIR) -I$(DOSBOX_DIR)/include $(INCLUDES) -c $< -o $@

$(RELEASE_DIR)/dosbox_emu.dll: $(DOSBOX_OBJS) $(NATIVE_REFS)
	$(CXX) $(NATIVE_LDFLAGS) -o $@ $(DOSBOX_OBJS) $(NATIVE_REFS) -lkernel32 -luser32 -lshell32

# ---- bochs_emu.dll --------------------------------------------------------
# (the original project defines DOSBOX_EMU_EXPORTS for bochs too)
