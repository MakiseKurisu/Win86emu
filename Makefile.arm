define YACT_template
$(YACT_DLLS_DIR)/$(1)_yact/%.o: $(YACT_DLLS_DIR)/$(1)_yact/%.cpp
	$$(CXX) $$(NATIVE_CXXFLAGS) -DUNICODE -D_UNICODE -D$(2)_YACT_EXPORTS -I$$(YACT_DLLS_DIR)/$(1)_yact $$(INCLUDES) -c $$< -o $$@

$(RELEASE_DIR)/$(1).nt.dll: $$($(2)_NT_OBJS) $$(NATIVE_REFS) $$(YACT_EXTRA_LIBS_$(1))
	$$(CXX) $$(NATIVE_LDFLAGS) -o $$@ $$($(2)_NT_OBJS) $$(NATIVE_REFS) $$(YACT_EXTRA_LIBS_$(1)) $$(NATIVE_LIBS)
endef

$(foreach s,$(YACT_NAMES),$(eval $(call YACT_template,$(s),$(shell echo $(s) | tr a-z A-Z))))

yact: $(addprefix $(RELEASE_DIR)/,$(addsuffix .nt.dll,$(YACT_NAMES)))

native: all $(RELEASE_DIR)/peldr.nt.dll $(RELEASE_DIR)/cpihook.nt.dll $(RELEASE_DIR)/dosbox_emu.dll $(RELEASE_DIR)/bochs_emu.dll yact

# The release configuration of x86_emu.dll loads 16 engine files:
# "dosbox_emu.dll" (i=0) plus "dosbox_emu1.dll" ... "dosbox_emu15.dll"
# (yact/x86_emu/x86_emu.cpp, LoadEmulatorDll / NUM_DOSBOXES=16). There is no
# separate vcxproj for the numbered files: each one is a byte-identical copy
# of the built dosbox_emu.dll, loaded as its own module so that every module
# gets its own emulation state. The debug configuration loads only
# dosbox_emu.dll (NUM_DOSBOXES=1).
DOSBOX_SLOTS = $(addprefix $(RELEASE_DIR)/dosbox_emu,$(addsuffix .dll,$(shell seq 1 15)))

dosbox-slots: $(RELEASE_DIR)/dosbox_emu.dll $(DOSBOX_SLOTS)

$(DOSBOX_SLOTS): $(RELEASE_DIR)/dosbox_emu.dll
	cp $< $@

# Clean build artifacts
clean:
	rm -f $(SUPP_DIR)/*.o $(YACT_EMU_DIR)/*.o $(X86_EMU_DIR)/*.o $(CBACKS_DIR)/*.o
	rm -f $(RELEASE_DIR)/*.dll $(RELEASE_DIR)/*.exe
	rm -f $(PELDR_DIR)/*.o $(CPIHOOK_DIR)/*.o $(DOSBOX_DIR)/*.o
	rm -f $(BOCHS_DIR)/*.o $(BOCHS_DIR)/*/*.o
	rm -f $(YACT_DLLS_DIR)/*_yact/*.o
	rm -f $(OBJ_DIR)/libwininet_extra.a $(OBJ_DIR)/libwinspool_extra.a

# Phony targets
.PHONY: all clean native yact dosbox-slots

# Debug: print variables
print-vars:
	@echo "CROSS_PREFIX: $(CROSS_PREFIX)"
	@echo "CXX: $(CXX)"
	@echo "CXXFLAGS: $(CXXFLAGS)"
	@echo "INCLUDES: $(INCLUDES)"
	@echo "SUPP_OBJS: $(SUPP_OBJS)"
	@echo "YACT_EMU_OBJS: $(YACT_EMU_OBJS)"
	@echo "X86_EMU_OBJS: $(X86_EMU_OBJS)"
	@echo "CBACKS_OBJS: $(CBACKS_OBJS)"
