	$(CXX) $(NATIVE_LDFLAGS) -o $@ $(BOCHS_OBJS) $(NATIVE_REFS) -lkernel32 -luser32 -ladvapi32

# ---- yact system DLLs (*.nt.dll, 72 projects) -----------------------------
YACT_EXTRA_LIBS_ntdll = $(YACT_DLLS_DIR)/ntdll_yact/ntdll_arm.lib
YACT_EXTRA_LIBS_ddraw = $(YACT_DLLS_DIR)/ddraw_yact/ddraw_arm.lib
YACT_EXTRA_LIBS_wininet = $(OBJ_DIR)/libwininet_extra.a
YACT_EXTRA_LIBS_winspool = $(OBJ_DIR)/libwinspool_extra.a

ACLUI_NT_OBJS = $(YACT_DLLS_DIR)/aclui_yact/dllmain.o $(YACT_DLLS_DIR)/aclui_yact/stdafx.o $(YACT_DLLS_DIR)/aclui_yact/aclui.o
ADVAPI32_NT_OBJS = $(YACT_DLLS_DIR)/advapi32_yact/advapi32.o $(YACT_DLLS_DIR)/advapi32_yact/advapi32_impl.o $(YACT_DLLS_DIR)/advapi32_yact/dllmain.o $(YACT_DLLS_DIR)/advapi32_yact/stdafx.o
CFGMGR32_NT_OBJS = $(YACT_DLLS_DIR)/cfgmgr32_yact/dllmain.o $(YACT_DLLS_DIR)/cfgmgr32_yact/stdafx.o $(YACT_DLLS_DIR)/cfgmgr32_yact/cfgmgr32.o
COMCTL32_NT_OBJS = $(YACT_DLLS_DIR)/comctl32_yact/comctl32.o $(YACT_DLLS_DIR)/comctl32_yact/comctl32_impl.o
COMDLG32_NT_OBJS = $(YACT_DLLS_DIR)/comdlg32_yact/comdlg32.o $(YACT_DLLS_DIR)/comdlg32_yact/comdlg32_impl.o $(YACT_DLLS_DIR)/comdlg32_yact/dllmain.o $(YACT_DLLS_DIR)/comdlg32_yact/stdafx.o
CRYPT32_NT_OBJS = $(YACT_DLLS_DIR)/crypt32_yact/dllmain.o $(YACT_DLLS_DIR)/crypt32_yact/stdafx.o $(YACT_DLLS_DIR)/crypt32_yact/crypt32.o
D3D9_NT_OBJS = $(YACT_DLLS_DIR)/d3d9_yact/dllmain.o $(YACT_DLLS_DIR)/d3d9_yact/stdafx.o $(YACT_DLLS_DIR)/d3d9_yact/d3d9.o
DBGHELP_NT_OBJS = $(YACT_DLLS_DIR)/dbghelp_yact/dbghelp.o $(YACT_DLLS_DIR)/dbghelp_yact/dllmain.o $(YACT_DLLS_DIR)/dbghelp_yact/stdafx.o
DDRAW_NT_OBJS = $(YACT_DLLS_DIR)/ddraw_yact/ddraw.o $(YACT_DLLS_DIR)/ddraw_yact/ddraw_common.o $(YACT_DLLS_DIR)/ddraw_yact/ddraw_impl.o $(YACT_DLLS_DIR)/ddraw_yact/dllmain.o $(YACT_DLLS_DIR)/ddraw_yact/stdafx.o
DHCPCSVC_NT_OBJS = $(YACT_DLLS_DIR)/dhcpcsvc_yact/dllmain.o $(YACT_DLLS_DIR)/dhcpcsvc_yact/stdafx.o $(YACT_DLLS_DIR)/dhcpcsvc_yact/dhcpcsvc.o
DNSAPI_NT_OBJS = $(YACT_DLLS_DIR)/dnsapi_yact/dllmain.o $(YACT_DLLS_DIR)/dnsapi_yact/stdafx.o $(YACT_DLLS_DIR)/dnsapi_yact/dnsapi.o
DSOUND_NT_OBJS = $(YACT_DLLS_DIR)/dsound_yact/dllmain.o $(YACT_DLLS_DIR)/dsound_yact/dsound.o $(YACT_DLLS_DIR)/dsound_yact/dsound_impl.o $(YACT_DLLS_DIR)/dsound_yact/stdafx.o
FAULTREP_NT_OBJS = $(YACT_DLLS_DIR)/faultrep_yact/dllmain.o $(YACT_DLLS_DIR)/faultrep_yact/stdafx.o $(YACT_DLLS_DIR)/faultrep_yact/faultrep.o
GDI32_NT_OBJS = $(YACT_DLLS_DIR)/gdi32_yact/dllmain.o $(YACT_DLLS_DIR)/gdi32_yact/gdi32.o $(YACT_DLLS_DIR)/gdi32_yact/stdafx.o
GDIPLUS_NT_OBJS = $(YACT_DLLS_DIR)/gdiplus_yact/dllmain.o $(YACT_DLLS_DIR)/gdiplus_yact/stdafx.o $(YACT_DLLS_DIR)/gdiplus_yact/gdiplus.o
HID_NT_OBJS = $(YACT_DLLS_DIR)/hid_yact/dllmain.o $(YACT_DLLS_DIR)/hid_yact/hid.o $(YACT_DLLS_DIR)/hid_yact/stdafx.o
ICMUI_NT_OBJS = $(YACT_DLLS_DIR)/icmui_yact/dllmain.o $(YACT_DLLS_DIR)/icmui_yact/stdafx.o $(YACT_DLLS_DIR)/icmui_yact/icmui.o
IMAGEHLP_NT_OBJS = $(YACT_DLLS_DIR)/imagehlp_yact/dllmain.o $(YACT_DLLS_DIR)/imagehlp_yact/stdafx.o $(YACT_DLLS_DIR)/imagehlp_yact/imagehlp.o
IMM32_NT_OBJS = $(YACT_DLLS_DIR)/imm32_yact/dllmain.o $(YACT_DLLS_DIR)/imm32_yact/stdafx.o $(YACT_DLLS_DIR)/imm32_yact/imm32.o
IPHLPAPI_NT_OBJS = $(YACT_DLLS_DIR)/iphlpapi_yact/dllmain.o $(YACT_DLLS_DIR)/iphlpapi_yact/stdafx.o $(YACT_DLLS_DIR)/iphlpapi_yact/iphlpapi.o
